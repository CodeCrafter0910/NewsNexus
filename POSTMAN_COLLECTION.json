{
  "info": {
    "name": "NewsNexus API",
    "description": "Multi-source news digest API collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "Get Full Digest",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "NewsNexus2024SecureKey",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/digest",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "digest"]
        }
      }
    },
    {
      "name": "Get Technology News",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "NewsNexus2024SecureKey",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/topic/technology",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "topic", "technology"]
        }
      }
    },
    {
      "name": "Get Politics News",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "NewsNexus2024SecureKey",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/topic/politics",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "topic", "politics"]
        }
      }
    },
    {
      "name": "Unauthorized Request (No API Key)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/digest",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "digest"]
        }
      }
    }
  ]
}
